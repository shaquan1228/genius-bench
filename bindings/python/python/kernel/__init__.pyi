from collections.abc import Sequence
from typing import Final, Literal, Protocol, Self, final

__all__ = [
    "Assessment",
    "Case",
    "Criterion",
    "SourceFile",
    "GradingError",
    "Instruction",
    "Issue",
    "KernelValue",
    "Outcome",
    "Predicate",
    "Record",
    "Reference",
    "REQUIRED_SCORES",
    "Rubric",
    "Task",
    "TextRule",
    "ValidationError",
    "Value",
    "Verification",
    "Verifier",
    "from_dataclass",
    "from_pydantic",
    "source_hash",
    "version",
]

class KernelValue(Protocol):
    def __kernel_value__(self) -> object: ...

@final
class Value:
    @staticmethod
    def from_python(*, value: object) -> Value: ...
    @property
    def kind(
        self,
    ) -> Literal["null", "bool", "int", "float", "string", "list", "record"]: ...
    @property
    def scalar(self) -> None | bool | int | float | str: ...
    @property
    def items(self) -> tuple[Value, ...]: ...
    @property
    def fields(self) -> tuple[tuple[str, Value], ...]: ...
    def get(self, *, path: Sequence[str]) -> Value | None: ...
    def equal(self, *, other: Value) -> bool: ...

@final
class Record:
    def __new__(cls, *, fields: Sequence[tuple[str, object]]) -> Self: ...
    @property
    def fields(self) -> tuple[tuple[str, Value], ...]: ...
    def __kernel_value__(self) -> Value: ...

@final
class Predicate:
    @staticmethod
    def present(*, path: Sequence[str]) -> Predicate: ...
    @staticmethod
    def equals(*, path: Sequence[str], expected: Value) -> Predicate: ...
    @staticmethod
    def within(*, path: Sequence[str], allowed: Sequence[Value]) -> Predicate: ...
    @staticmethod
    def contains(*, path: Sequence[str], item: Value) -> Predicate: ...
    @staticmethod
    def words(*, path: Sequence[str], min_words: int, max_words: int) -> Predicate: ...
    @staticmethod
    def all(*, checks: Sequence[tuple[str, Predicate]]) -> Predicate: ...
    @staticmethod
    def any(*, checks: Sequence[tuple[str, Predicate]]) -> Predicate: ...
    @staticmethod
    def not_(*, check: Predicate) -> Predicate: ...
    def holds(self, *, observation: Value) -> bool: ...
    @property
    def kind(
        self,
    ) -> Literal[
        "present", "equals", "within", "contains", "words", "all", "any", "not"
    ]: ...
    @property
    def path(self) -> tuple[str, ...] | None: ...
    @property
    def expected(self) -> Value | None: ...
    @property
    def item(self) -> Value | None: ...
    @property
    def allowed(self) -> tuple[Value, ...] | None: ...
    @property
    def min_words(self) -> int | None: ...
    @property
    def max_words(self) -> int | None: ...
    @property
    def checks(self) -> tuple[tuple[str, Predicate], ...]: ...
    @property
    def check(self) -> Predicate | None: ...

@final
class Verification:
    @staticmethod
    def unchecked() -> Verification: ...
    @staticmethod
    def passed() -> Verification: ...
    @staticmethod
    def failed() -> Verification: ...
    @staticmethod
    def invalid_submission() -> Verification: ...
    @staticmethod
    def timed_out() -> Verification: ...
    @staticmethod
    def harness_error(*, detail: str) -> Verification: ...
    @property
    def status(
        self,
    ) -> Literal[
        "unchecked",
        "passed",
        "failed",
        "invalid_submission",
        "timed_out",
        "harness_error",
    ]: ...
    @property
    def detail(self) -> str | None: ...

@final
class Outcome:
    def __new__(
        cls,
        *,
        changed_files: Sequence[str],
        verification: Verification,
        response: Value,
        facts: Sequence[tuple[str, Value]],
    ) -> Self: ...
    @property
    def changed_files(self) -> tuple[str, ...]: ...
    @property
    def verification(self) -> Verification: ...
    @property
    def response(self) -> Value: ...
    @property
    def facts(self) -> tuple[tuple[str, Value], ...]: ...
    def observation(self) -> Value: ...

@final
class Assessment:
    def __new__(cls, *, predicate: Predicate, observation: Value) -> Self: ...
    def passed(self) -> bool: ...
    def observed(self) -> Value | None: ...
    def scores(self) -> tuple[tuple[str, bool], ...]: ...
    @property
    def kind(self) -> Literal["check", "all"]: ...
    @property
    def predicate(self) -> Predicate | None: ...
    @property
    def observation(self) -> Value | None: ...
    @property
    def checks(self) -> tuple[tuple[str, Assessment], ...]: ...

@final
class SourceFile:
    def __new__(cls, *, path: str, contents: str) -> Self: ...
    @property
    def path(self) -> str: ...
    @property
    def contents(self) -> str: ...

@final
class Instruction:
    def __new__(cls, *, prompt: str) -> Self: ...
    @property
    def prompt(self) -> str: ...

@final
class Verifier:
    def __new__(
        cls,
        *,
        inputs: Sequence[str],
        files: Sequence[SourceFile],
        tools: Sequence[SourceFile],
        command: Sequence[str],
        stdin: str,
        timeout_seconds: int,
    ) -> Self: ...
    @property
    def inputs(self) -> tuple[str, ...]: ...
    @property
    def files(self) -> tuple[SourceFile, ...]: ...
    @property
    def tools(self) -> tuple[SourceFile, ...]: ...
    @property
    def command(self) -> tuple[str, ...]: ...
    @property
    def stdin(self) -> str: ...
    @property
    def timeout_seconds(self) -> int: ...

@final
class TextRule:
    def __new__(cls, *, field: str, min_words: int, max_words: int) -> Self: ...
    @property
    def field(self) -> str: ...
    @property
    def min_words(self) -> int: ...
    @property
    def max_words(self) -> int: ...

@final
class Rubric:
    def __new__(
        cls, *, expected: Sequence[tuple[str, Value]], text_rule: TextRule | None
    ) -> Self: ...
    @property
    def expected(self) -> tuple[tuple[str, Value], ...]: ...
    @property
    def text_rule(self) -> TextRule | None: ...

@final
class Criterion:
    @staticmethod
    def code(*, verifier: Verifier) -> Criterion: ...
    @staticmethod
    def answer(*, rubric: Rubric) -> Criterion: ...
    @staticmethod
    def state(*, predicate: Predicate) -> Criterion: ...
    def condition(self) -> Predicate: ...
    @property
    def kind(self) -> Literal["code", "answer", "state"]: ...
    @property
    def verifier(self) -> Verifier | None: ...
    @property
    def rubric(self) -> Rubric | None: ...
    @property
    def predicate(self) -> Predicate | None: ...

@final
class Reference:
    def __new__(cls, *, edits: Sequence[SourceFile], completion: object) -> Self: ...
    @property
    def edits(self) -> tuple[SourceFile, ...]: ...
    @property
    def completion(self) -> Value: ...

@final
class Case:
    @property
    def case_id(self) -> str: ...
    @property
    def prompt(self) -> str: ...
    @property
    def files(self) -> tuple[SourceFile, ...]: ...

@final
class Issue:
    @property
    def field(self) -> str: ...
    @property
    def message(self) -> str: ...

class ValidationError(ValueError):
    case_id: str | None
    issues: tuple[Issue, ...]

class GradingError(RuntimeError):
    failure: Literal["verification_harness_error"]
    detail: str

@final
class Task:
    def __new__(
        cls,
        *,
        id: str,
        fixture: Sequence[SourceFile],
        instruction: Instruction,
        criterion: Criterion,
        allowed_files: Sequence[str],
        reference: Reference,
    ) -> Self: ...
    @property
    def id(self) -> str: ...
    @property
    def fixture(self) -> tuple[SourceFile, ...]: ...
    @property
    def instruction(self) -> Instruction: ...
    @property
    def criterion(self) -> Criterion: ...
    @property
    def allowed_files(self) -> tuple[str, ...]: ...
    @property
    def reference(self) -> Reference: ...
    def checks(self) -> Verifier | None: ...
    def project(self) -> Case: ...
    def assess(self, *, outcome: Outcome) -> Assessment: ...
    def grade(self, *, outcome: Outcome) -> tuple[tuple[str, bool], ...]: ...
    def grade_reference(
        self, *, verification: Verification
    ) -> tuple[tuple[str, bool], ...]: ...

REQUIRED_SCORES: Final[tuple[str, str]]

def version() -> str: ...
def source_hash() -> str: ...
def from_dataclass(*, value: object) -> Value: ...
def from_pydantic(*, value: object) -> Value: ...
