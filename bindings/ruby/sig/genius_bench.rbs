module GeniusBench
  VERSION: String
  NESTING_LIMIT: Integer
  REQUIRED_SCORES: Array[String]

  def self.version: () -> String
  def self.source_hash: () -> String
  def self.from_struct: (value: Struct[untyped] | Data) -> Value

  interface _KernelValue
    def to_kernel_value: () -> kernel_input
  end

  type scalar = nil | bool | Integer | Float | String
  type kernel_input = scalar | Array[kernel_input] | Hash[String | Symbol, kernel_input] | Value | Record | _KernelValue
  type verification_status = "unchecked" | "passed" | "failed" | "invalid_submission" | "timed_out" | "harness_error"
  type scores = Array[[String, bool]]
  type named[T] = Array[[String | Symbol, T]] | Hash[String | Symbol, T]

  class Value
    def self.from_ruby: (value: kernel_input) -> Value
    def get: (path: Array[::String]) -> Value?
    def equal_to?: (other: kernel_input) -> bool
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> ::String

    class Null < Value
      def self.new: () -> Null
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, bot]
    end

    class Bool < Value
      def self.new: (value: bool) -> Bool
      def value: () -> bool
      def deconstruct_keys: (Array[Symbol]? keys) -> { value: bool }
    end

    class Int < Value
      def self.new: (value: Integer) -> Int
      def value: () -> Integer
      def deconstruct_keys: (Array[Symbol]? keys) -> { value: Integer }
    end

    class Float < Value
      def self.new: (value: ::Float) -> Float
      def value: () -> ::Float
      def deconstruct_keys: (Array[Symbol]? keys) -> { value: ::Float }
    end

    class String < Value
      def self.new: (value: ::String) -> String
      def value: () -> ::String
      def deconstruct_keys: (Array[Symbol]? keys) -> { value: ::String }
    end

    class List < Value
      def self.new: (items: Array[kernel_input]) -> List
      def items: () -> Array[Value]
      def deconstruct_keys: (Array[Symbol]? keys) -> { items: Array[Value] }
    end

    class Record < Value
      def self.new: (fields: named[kernel_input]) -> Record
      def fields: () -> Array[[::String, Value]]
      def deconstruct_keys: (Array[Symbol]? keys) -> { fields: Array[[::String, Value]] }
    end
  end

  class Record
    def self.new: (fields: named[kernel_input]) -> Record
    def fields: () -> Array[[String, Value]]
    def to_kernel_value: () -> Value::Record
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Predicate
    def holds?: (observation: kernel_input) -> bool
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String

    class Present < Predicate
      def self.new: (path: Array[String]) -> Present
      def path: () -> Array[String]
      def deconstruct_keys: (Array[Symbol]? keys) -> { path: Array[String] }
    end

    class Equals < Predicate
      def self.new: (path: Array[String], expected: kernel_input) -> Equals
      def path: () -> Array[String]
      def expected: () -> Value
      def deconstruct_keys: (Array[Symbol]? keys) -> { path: Array[String], expected: Value }
    end

    class Within < Predicate
      def self.new: (path: Array[String], allowed: Array[kernel_input]) -> Within
      def path: () -> Array[String]
      def allowed: () -> Array[Value]
      def deconstruct_keys: (Array[Symbol]? keys) -> { path: Array[String], allowed: Array[Value] }
    end

    class Contains < Predicate
      def self.new: (path: Array[String], item: kernel_input) -> Contains
      def path: () -> Array[String]
      def item: () -> Value
      def deconstruct_keys: (Array[Symbol]? keys) -> { path: Array[String], item: Value }
    end

    class Words < Predicate
      def self.new: (path: Array[String], min_words: Integer, max_words: Integer) -> Words
      def path: () -> Array[String]
      def min_words: () -> Integer
      def max_words: () -> Integer
      def deconstruct_keys: (Array[Symbol]? keys) -> { path: Array[String], min_words: Integer, max_words: Integer }
    end

    class All < Predicate
      def self.new: (checks: named[Predicate]) -> All
      def checks: () -> Array[[String, Predicate]]
      def deconstruct_keys: (Array[Symbol]? keys) -> { checks: Array[[String, Predicate]] }
    end

    class Any < Predicate
      def self.new: (checks: named[Predicate]) -> Any
      def checks: () -> Array[[String, Predicate]]
      def deconstruct_keys: (Array[Symbol]? keys) -> { checks: Array[[String, Predicate]] }
    end

    class Not < Predicate
      def self.new: (check: Predicate) -> Not
      def check: () -> Predicate
      def deconstruct_keys: (Array[Symbol]? keys) -> { check: Predicate }
    end
  end

  class Verification
    def status: () -> verification_status
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String

    class Unchecked < Verification
      def self.new: () -> Unchecked
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, bot]
    end

    class Passed < Verification
      def self.new: () -> Passed
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, bot]
    end

    class Failed < Verification
      def self.new: () -> Failed
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, bot]
    end

    class InvalidSubmission < Verification
      def self.new: () -> InvalidSubmission
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, bot]
    end

    class TimedOut < Verification
      def self.new: () -> TimedOut
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, bot]
    end

    class HarnessError < Verification
      def self.new: (detail: String) -> HarnessError
      def detail: () -> String
      def deconstruct_keys: (Array[Symbol]? keys) -> { detail: String }
    end
  end

  class Outcome
    def self.new: (changed_files: Array[String], verification: Verification, response: kernel_input, facts: named[kernel_input]) -> Outcome
    def changed_files: () -> Array[String]
    def verification: () -> Verification
    def response: () -> Value
    def facts: () -> Array[[String, Value]]
    def observation: () -> Value
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Assessment
    def self.new: (predicate: Predicate, observation: kernel_input) -> (Check | All)
    def passed?: () -> bool
    def observed: () -> Value?
    def scores: () -> scores
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String

    class Check < Assessment
      def self.new: (predicate: Predicate, observation: kernel_input) -> Check
      def predicate: () -> Predicate
      def observation: () -> Value
      def deconstruct_keys: (Array[Symbol]? keys) -> { predicate: Predicate, observation: Value }
    end

    class All < Assessment
      def self.new: (checks: named[Assessment]) -> All
      def checks: () -> Array[[String, Assessment]]
      def deconstruct_keys: (Array[Symbol]? keys) -> { checks: Array[[String, Assessment]] }
    end
  end

  class SourceFile
    def self.new: (path: String, contents: String) -> SourceFile
    def path: () -> String
    def contents: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Instruction
    def self.new: (prompt: String) -> Instruction
    def prompt: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Verifier
    def self.new: (inputs: Array[String], files: Array[SourceFile], tools: Array[SourceFile], command: Array[String], stdin: String, timeout_seconds: Integer) -> Verifier
    def inputs: () -> Array[String]
    def files: () -> Array[SourceFile]
    def tools: () -> Array[SourceFile]
    def command: () -> Array[String]
    def stdin: () -> String
    def timeout_seconds: () -> Integer
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class TextRule
    def self.new: (field: String, min_words: Integer, max_words: Integer) -> TextRule
    def field: () -> String
    def min_words: () -> Integer
    def max_words: () -> Integer
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Rubric
    def self.new: (expected: named[kernel_input], text_rule: TextRule?) -> Rubric
    def expected: () -> Array[[String, Value]]
    def text_rule: () -> TextRule?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Criterion
    def condition: () -> Predicate
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String

    class Code < Criterion
      def self.new: (verifier: Verifier) -> Code
      def verifier: () -> Verifier
      def deconstruct_keys: (Array[Symbol]? keys) -> { verifier: Verifier }
    end

    class Answer < Criterion
      def self.new: (rubric: Rubric) -> Answer
      def rubric: () -> Rubric
      def deconstruct_keys: (Array[Symbol]? keys) -> { rubric: Rubric }
    end

    class State < Criterion
      def self.new: (predicate: Predicate) -> State
      def predicate: () -> Predicate
      def deconstruct_keys: (Array[Symbol]? keys) -> { predicate: Predicate }
    end
  end

  class Reference
    def self.new: (edits: Array[SourceFile], completion: kernel_input) -> Reference
    def edits: () -> Array[SourceFile]
    def completion: () -> Value
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Case
    def case_id: () -> String
    def prompt: () -> String
    def files: () -> Array[SourceFile]
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Issue
    def field: () -> String
    def message: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class ValidationError < ArgumentError
    def case_id: () -> String?
    def issues: () -> Array[Issue]
  end

  class GradingError < RuntimeError
    def failure: () -> "verification_harness_error"
    def detail: () -> String
  end

  class Task
    def self.new: (id: String, fixture: Array[SourceFile], instruction: Instruction, criterion: Criterion, allowed_files: Array[String], reference: Reference) -> Task
    def id: () -> String
    def fixture: () -> Array[SourceFile]
    def instruction: () -> Instruction
    def criterion: () -> Criterion
    def allowed_files: () -> Array[String]
    def reference: () -> Reference
    def project: () -> Case
    def checks: () -> Verifier?
    def assess: (outcome: Outcome) -> Assessment
    def grade: (outcome: Outcome) -> scores
    def grade_reference: (verification: Verification) -> scores
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end
end
