module GeniusBench
  VERSION: String
  NESTING_LIMIT: Integer
  REQUIRED_SCORES: Array[String]

  def self.version: () -> String
  def self.source_hash: () -> String
  def self.from_struct: (value: Struct[untyped] | Data) -> Value

  interface _KernelValue
    def to_kernel_value: () -> kernel_input
  end

  type scalar = nil | bool | Integer | Float | String
  type kernel_input = scalar | Array[kernel_input] | Hash[String | Symbol, kernel_input] | Value | Record | _KernelValue
  type value_kind = "null" | "bool" | "int" | "float" | "string" | "list" | "record"
  type predicate_kind = "present" | "equals" | "within" | "contains" | "words" | "all" | "any" | "not"
  type verification_status = "unchecked" | "passed" | "failed" | "invalid_submission" | "timed_out" | "harness_error"
  type scores = Array[[String, bool]]
  type named[T] = Array[[String | Symbol, T]] | Hash[String | Symbol, T]

  class Value
    def self.from_ruby: (value: kernel_input) -> Value
    def kind: () -> value_kind
    def scalar: () -> scalar
    def items: () -> Array[Value]
    def fields: () -> Array[[String, Value]]
    def get: (path: Array[String]) -> Value?
    def equal_to?: (other: kernel_input) -> bool
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Record
    def self.new: (fields: named[kernel_input]) -> Record
    def fields: () -> Array[[String, Value]]
    def to_kernel_value: () -> Value
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Predicate
    def self.present: (path: Array[String]) -> Predicate
    def self.equals: (path: Array[String], expected: kernel_input) -> Predicate
    def self.within: (path: Array[String], allowed: Array[kernel_input]) -> Predicate
    def self.contains: (path: Array[String], item: kernel_input) -> Predicate
    def self.words: (path: Array[String], min_words: Integer, max_words: Integer) -> Predicate
    def self.all: (checks: named[Predicate]) -> Predicate
    def self.any: (checks: named[Predicate]) -> Predicate
    def self.not: (check: Predicate) -> Predicate
    def holds?: (observation: kernel_input) -> bool
    def kind: () -> predicate_kind
    def path: () -> Array[String]?
    def expected: () -> Value?
    def item: () -> Value?
    def allowed: () -> Array[Value]?
    def min_words: () -> Integer?
    def max_words: () -> Integer?
    def checks: () -> Array[[String, Predicate]]
    def check: () -> Predicate?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Verification
    def self.unchecked: () -> Verification
    def self.passed: () -> Verification
    def self.failed: () -> Verification
    def self.invalid_submission: () -> Verification
    def self.timed_out: () -> Verification
    def self.harness_error: (detail: String) -> Verification
    def status: () -> verification_status
    def detail: () -> String?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Outcome
    def self.new: (changed_files: Array[String], verification: Verification, response: kernel_input, facts: named[kernel_input]) -> Outcome
    def changed_files: () -> Array[String]
    def verification: () -> Verification
    def response: () -> Value
    def facts: () -> Array[[String, Value]]
    def observation: () -> Value
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Assessment
    def self.new: (predicate: Predicate, observation: kernel_input) -> Assessment
    def passed?: () -> bool
    def observed: () -> Value?
    def scores: () -> scores
    def kind: () -> ("check" | "all")
    def predicate: () -> Predicate?
    def observation: () -> Value?
    def checks: () -> Array[[String, Assessment]]
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class SourceFile
    def self.new: (path: String, contents: String) -> SourceFile
    def path: () -> String
    def contents: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Instruction
    def self.new: (prompt: String) -> Instruction
    def prompt: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Verifier
    def self.new: (inputs: Array[String], files: Array[SourceFile], tools: Array[SourceFile], command: Array[String], stdin: String, timeout_seconds: Integer) -> Verifier
    def inputs: () -> Array[String]
    def files: () -> Array[SourceFile]
    def tools: () -> Array[SourceFile]
    def command: () -> Array[String]
    def stdin: () -> String
    def timeout_seconds: () -> Integer
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class TextRule
    def self.new: (field: String, min_words: Integer, max_words: Integer) -> TextRule
    def field: () -> String
    def min_words: () -> Integer
    def max_words: () -> Integer
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Rubric
    def self.new: (expected: named[kernel_input], text_rule: TextRule?) -> Rubric
    def expected: () -> Array[[String, Value]]
    def text_rule: () -> TextRule?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Criterion
    def self.code: (verifier: Verifier) -> Criterion
    def self.answer: (rubric: Rubric) -> Criterion
    def self.state: (predicate: Predicate) -> Criterion
    def condition: () -> Predicate
    def kind: () -> ("code" | "answer" | "state")
    def verifier: () -> Verifier?
    def rubric: () -> Rubric?
    def predicate: () -> Predicate?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Reference
    def self.new: (edits: Array[SourceFile], completion: kernel_input) -> Reference
    def edits: () -> Array[SourceFile]
    def completion: () -> Value
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Case
    def case_id: () -> String
    def prompt: () -> String
    def files: () -> Array[SourceFile]
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class Issue
    def field: () -> String
    def message: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end

  class ValidationError < ArgumentError
    def case_id: () -> String?
    def issues: () -> Array[Issue]
  end

  class GradingError < RuntimeError
    def failure: () -> "verification_harness_error"
    def detail: () -> String
  end

  class Task
    def self.new: (id: String, fixture: Array[SourceFile], instruction: Instruction, criterion: Criterion, allowed_files: Array[String], reference: Reference) -> Task
    def id: () -> String
    def fixture: () -> Array[SourceFile]
    def instruction: () -> Instruction
    def criterion: () -> Criterion
    def allowed_files: () -> Array[String]
    def reference: () -> Reference
    def project: () -> Case
    def checks: () -> Verifier?
    def assess: (outcome: Outcome) -> Assessment
    def grade: (outcome: Outcome) -> scores
    def grade_reference: (verification: Verification) -> scores
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
  end
end
